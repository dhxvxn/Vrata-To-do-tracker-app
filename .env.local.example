# Copy this file to `.env.local` and fill in the values below.
# All keys must be prefixed with VITE_ so Vite exposes them to the client.

# Google Gemini API key — powers the voice assistant's command parsing and
# the Analytics productivity insight. Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Google OAuth 2.0 Client ID (type: Web application) — powers the two-way
# Google Calendar integration (and, later, Google Fit for Luna band data).
# 1. Create it at https://console.cloud.google.com/apis/credentials
# 2. Enable the "Google Calendar API" for the project.
# 3. Under "Authorized JavaScript origins" add your dev + prod origins,
#    e.g. http://localhost:5173 and your deployed URL.
# The Client ID is public/safe to ship in the browser bundle (no secret).
VITE_GOOGLE_CLIENT_ID=
