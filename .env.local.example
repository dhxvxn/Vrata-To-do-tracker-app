# Copy this file to `.env.local` and fill in only what you want.
# EVERYTHING here is OPTIONAL — the app runs fully free with no keys at all.
# All keys must be prefixed with VITE_ so Vite exposes them to the client.

# ---- Optional: nicer AI-written Analytics insight ----
# Without this, Analytics shows a good insight generated locally from your stats.
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# ---- Optional: two-way Google Calendar ----
# OAuth 2.0 Client ID (type: Web application).
# 1. Create it at https://console.cloud.google.com/apis/credentials
# 2. Enable the "Google Calendar API" for the project.
# 3. Add your origins (e.g. http://localhost:5173) to Authorized JavaScript origins.
# The Client ID is public/safe to ship in the browser.
VITE_GOOGLE_CLIENT_ID=

# ---- Optional: cross-device sync (phone <-> desktop) via Firebase ----
# Create a free Firebase project, enable Google sign-in + Firestore, then copy
# the web app config here. All of these are PUBLIC values (safe to ship).
# See the README section "Enable cross-device sync (Firebase)".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
